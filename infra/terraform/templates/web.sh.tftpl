#!/bin/bash
# Web tier bootstrap: install Docker, pull the image from ECR, run nginx. No secrets on this tier.
set -uxo pipefail
exec > >(tee /var/log/axon-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker

REGION="${region}"
IMAGE="${image}"
REGISTRY="$(echo "$IMAGE" | cut -d/ -f1)"

# The repository may be empty on the very first deploy; keep retrying until CI/CD (or a manual push) lands an image.
for i in $(seq 1 120); do
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY" && docker pull "$IMAGE" && break
  echo "image not available yet (attempt $i), retrying in 15s"
  sleep 15
done

docker rm -f web 2>/dev/null || true
docker run -d --name web --restart unless-stopped -p 80:80 \
  -e API_UPSTREAM="${api_upstream}" \
  -e DNS_RESOLVER="${dns_resolver}" \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  "$IMAGE"
